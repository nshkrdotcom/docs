{
  "name": "elixirscope-interface-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Zero-dependency, offline-ready TypeScript mockups for an investigation-first code review workbench",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit false",
    "preview": "python3 -m http.server 4173",
    "test": "node tests/smoke.cjs && node tests/interaction.cjs",
    "snapshots": "node tests/generate-previews.cjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
