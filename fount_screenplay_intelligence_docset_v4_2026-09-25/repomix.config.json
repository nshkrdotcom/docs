{
  "output": {
    "filePath": "docset.raw.xml",
    "style": "xml",
    "parsableStyle": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "include": [
    ".gitignore",
    "**/*.md",
    "**/*.json",
    "**/*.txt",
    "**/*.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/.git/**",
      "**/__pycache__/**",
      "**/*.xml",
      "**/*.zip"
    ]
  }
}