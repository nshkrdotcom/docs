  "runtime_test_sources": {
    "packages/fount_observe/test/phase_two_contracts_test.exs": [
      "the data-shape digest ignores prose but changes with the answer domain",
      "context contract schemas are closed recursively, not just at slot names",
      "typed context roundtrips without creating atoms from input",
      "evidence identity is storage provenance, not model-visible fact content",
      "calibration is explicit, preserves the raw distribution and does not calibrate confidence",
      "custom lens declarations cannot configure executables, endpoints or credentials",
      "distribution variants reject fields that contradict their serialized shape",
      "oversized output declarations are rejected as contracts, not dispatched"
    ],
    "packages/fount_observe/test/phase_two_execution_test.exs": [
      "ETS cache supports capped LRU storage, clear and expiry",
      "cache poison in either contract or raw payload is reacquired",
      "changing context changes measurement identity but changing revision does not",
      "lens resource requests cannot raise host caps or spend budget at preflight",
      "state and question caps fail before dispatch",
      "mutable aliases cannot be promoted to durable identity by their spelling",
      "credential-like transport extras are rejected, not persisted",
      "raw measurements, separate calibration, resources and exact model metadata survive",
      "configured normalization tolerance applies to Sandbox as well as the SDK",
      "atomic reservations cannot overspend one shared state budget",
      "a cache entry cannot smuggle unrecognized provider metadata into a new observation"
    ],
    "packages/fount_observe/test/phase_two_provider_test.exs": [
      "completed results survive total timeout and can be reused while failed states stay unavailable",
      "finite provider request cap disables retries and prevents a second dispatch",
      "wire request size failures are neutral, contain no raw request and spend no remote call"
    ],
    "packages/fount_observe/test/phase_two_scene_question_test.exs": [
      "a scene question returns evidence without changing the source or claiming fixture insight",
      "missing provider is an honest unavailable answer, never a negative scene verdict"
    ],
    "packages/fount_observe/test/phase_two_sources_test.exs": [
      "public scene request keeps private notes and source IDs out of model input",
      "human and deterministic records do not fabricate probabilities",
      "imported measurements are input-bound and reject stale contract digests",
      "data-only sandbox fixture files bind questions and semantic input",
      "record imports cannot relabel an identical input under a different projection",
      "cache reuse rebinds every exact excerpt and dependency to the current screenplay",
      "request provenance must be a map and malformed evidence never reaches materialization",
      "the packaged semantic fixture is executable through the normal acquisition path"
    ]
  },
