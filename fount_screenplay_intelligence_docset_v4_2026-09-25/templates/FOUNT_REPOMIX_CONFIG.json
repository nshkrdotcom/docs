{
  "$schema": "https://raw.githubusercontent.com/yamadashy/repomix/main/repomix.schema.json",
  "output": {
    "filePath": "fount.xml",
    "style": "xml",
    "parsableStyle": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "include": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "mix.exs",
    "mix.lock",
    ".formatter.exs",
    ".gitignore",
    ".github/**",
    "repomix.config.json",
    "scripts/**",
    "handoff/apply_overlay.py",
    "packages/**",
    "AGENTS.md",
    "apps/**",
    "config/**",
    "docs/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/.git/**",
      "**/.elixir_ls/**",
      "**/.blitz/**",
      "**/_build/**",
      "**/deps/**",
      "**/doc/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.env*",
      "fount.xml",
      "repomix-output*.xml",
      "**/*.pdf",
      "**/*.dump",
      "**/*.tar",
      "**/examples/_downloads/**",
      "**/examples/_output/**",
      "**/*.zip",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.ico",
      "**/*.woff*",
      "**/*.mp3",
      "**/*.wav",
      "**/*.beam",
      "**/*.ez",
      "**/*.key",
      "**/*.pem",
      "*.raw.xml",
      "system_one_sdk.xml",
      "inference.xml",
      "agent_session_manager.xml",
      "docset.xml"
    ]
  }
}